# Generated
#
# The artifact bundle is rebuilt from web/ by artifact/build.py; the browser
# test fixtures are patched personal photos and stay local.
# ---------------------------------------------------------------------------
artifact/build/
tests/web/ref/
tests/private-fixtures/

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.vscode/
.stylio-site/
.idea/
.claude/settings.local.json
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Cached libheif bundle for tests/web/libheif-api.mjs (1.8 MB, refetched on demand).
tests/web/.cache/

# Local previous project and reference checkouts
ref/
.agents

# Downloaded opt-in AI binaries; Pages CI fetches the pinned, verified copies.
web/vendor/ai-portrait/*.onnx
web/vendor/ai-portrait/*.onnx_data
web/vendor/ai-portrait/*.wasm

# Suggested Styles intentionally ships its compact, image-only ONNX package under
# web/vendor/ai-style/. Do not add a blanket *.onnx ignore above this point.
# Large Pro models are reconstructed from tracked .partNNN files.
web/vendor/ai-style/siglip2-base-patch16-224-image-int8.onnx
web/vendor/ai-style/siglip2-base-patch16-224-image-fp16.onnx
#
# Hugging Face AI detail weights are downloaded to the user's local machine.
# Verify licensing before distributing the model binaries with the public app.
web/vendor/ai-detail/*.onnx
web/vendor/ai-detail/*.onnx_data
web/vendor/ai-detail/*.partial
research
