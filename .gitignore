.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Patch output
#
# Every `patch` run writes OUT.HEIC + OUT.HEIC.report.json, and OUT.zip with
# --zip. None of it is source.
# ---------------------------------------------------------------------------
*_out/
*_test/
*.HEIC.report.json
*_SmartStyle.HEIC
*_SmartStyle.zip
*_PhotographicStyle.HEIC
*_PhotographicStyle.zip
*_reuseThumb.HEIC
*_reuseThumb.zip

# ---------------------------------------------------------------------------
# Sample photos
#
# The HEICs this was developed against are personal originals, tens of MB each.
# They are deliberately not distributed; supply your own.
# ---------------------------------------------------------------------------
Smartstyle/
noSmartStyle/
noSmartStyle-people/
*.HEIC
*.heic
*.HEIF
*.heif

