smartstyle_port_v0_1.py
VERSION_v0_1.txt

# Per-version notes and findings, folded into README.md.
README_PhotographicStyle_Port_v0_*.md
PhotographicStyle_HEIC_Porting_Experimental_Facts.md

# Legacy release artifacts; donor profiles are embedded in the script now.
SmartStyle_Port_v0_1_bundle.zip
IMG_0307_SmartStyle_donor_profile_v0_1.zip

